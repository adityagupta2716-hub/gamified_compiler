# Compiler Quest — Environment Variables Example
# Copy this file to .env and fill in your values

# ── Backend Port ──────────────────────────────────────────────
PORT=5000

# ── MongoDB (optional — app works without it using in-memory storage) ──
# MONGODB_URI=mongodb://localhost:27017/compiler_quest

# ── Frontend Dev Server (auto-set by Vite, listed for reference) ──
# VITE_API_BASE_URL=http://localhost:5000
